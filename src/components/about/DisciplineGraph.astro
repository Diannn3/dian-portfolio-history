---
const nodes = [
  { id: 'math', label: 'MATH', x: 150, y: 100 },
  { id: 'software', label: 'SOFTWARE', x: 300, y: 80 },
  { id: 'ai', label: 'AI', x: 450, y: 120 },
  { id: 'data', label: 'DATA', x: 250, y: 200 },
  { id: 'spatial', label: 'SPATIAL', x: 400, y: 220 },
  { id: 'design', label: 'DESIGN', x: 200, y: 280 },
];
const edges = [
  ['math', 'software'],
  ['math', 'ai'],
  ['math', 'data'],
  ['software', 'ai'],
  ['software', 'spatial'],
  ['data', 'spatial'],
  ['data', 'design'],
  ['ai', 'design'],
  ['spatial', 'design'],
];
---

<div class="w-full max-w-md mx-auto" aria-label="Discipline relationship graph">
  <svg viewBox="0 0 600 350" class="w-full h-auto">
    {edges.map(([from, to]) => {
      const fromNode = nodes.find(n => n.id === from)!;
      const toNode = nodes.find(n => n.id === to)!;
      return (
        <line
          x1={fromNode.x} y1={fromNode.y}
          x2={toNode.x} y2={toNode.y}
          stroke="#D8D4CC"
          stroke-width="1"
          class="transition-colors hover:stroke-accent"
        />
      );
    })}
    {nodes.map((node) => (
      <g
        role="button"
        tabindex="0"
        aria-label={`${node.label} discipline`}
        class="cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent"
      >
        <circle
          cx={node.x} cy={node.y} r="6"
          fill="#111111"
          class="transition-all hover:fill-accent hover:r-8"
          style="transform-origin: center;"
        />
        <text
          x={node.x + 12} y={node.y + 4}
          fill="#555555"
          font-family="JetBrains Mono, monospace"
          font-size="11"
          class="pointer-events-none"
        >
          {node.label}
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  svg circle {
    transition: fill 0.3s ease, r 0.3s ease;
    r: 6px;
  }
  svg circle:hover {
    fill: var(--color-accent);
    r: 8px;
  }
</style>