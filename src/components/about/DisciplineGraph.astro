---
const nodes: [string, string, number, number][]=[['math','MATH',130,105],['software','SOFTWARE',315,72],['ai','AI',470,128],['data','DATA',245,205],['spatial','SPATIAL',430,235],['design','DESIGN',175,295]];
const edges=[['math','software'],['math','data'],['software','ai'],['software','spatial'],['data','spatial'],['data','design'],['ai','design'],['spatial','design']]; const byId=Object.fromEntries(nodes.map(n=>[n[0],n]));
---
<figure><figcaption class="mono-label mb-5">Discipline graph / relationships</figcaption><svg viewBox="0 0 600 360" class="w-full" role="img" aria-label="Connections between mathematics, software, AI, data, spatial systems, and design"><g stroke="#d8d4cc">{edges.map(([a,b])=><line x1={byId[a][2]} y1={byId[a][3]} x2={byId[b][2]} y2={byId[b][3]}/>)}</g>{nodes.map(([_id,label,x,y])=><g class="discipline-node" tabindex="0" aria-label={label}><circle cx={x} cy={y} r="6"/><text x={Number(x)+13} y={Number(y)+4}>{label}</text></g>)}</svg></figure><style>.discipline-node circle{fill:#111;transition:fill .2s,r .2s}.discipline-node text{fill:#64615c;font-family:var(--font-mono);font-size:11px}.discipline-node:hover circle,.discipline-node:focus circle{fill:#d94f2b;r:9px}.discipline-node:focus{outline:none}</style>
