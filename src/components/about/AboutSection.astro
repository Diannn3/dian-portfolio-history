---
import DisciplineGraph from './DisciplineGraph.astro';
---

<section id="about" class="section-padding border-t border-hairline">
  <div class="container-editorial">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24">
      <div>
        <p class="mono-label mb-4">About</p>
        <h2 class="text-h1 font-display text-ink mb-8">
          I like problems that sit between equations and interfaces.
        </h2>
        <p class="text-body-lg text-graphite mb-6">
          I'm Dian, an Applied Mathematics student and developer. I build software, AI, maps, spatial systems, and experimental interfaces.
        </p>
        <p class="text-body text-graphite">
          My practice sits at the intersection of mathematical modeling, software engineering, and design. I'm interested in how abstract systems become tangible tools.
        </p>
      </div>
      <div class="flex items-center">
        <DisciplineGraph />
      </div>
    </div>
  </div>
</section>