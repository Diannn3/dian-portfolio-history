---
import { getCollection } from 'astro:content';
import ProjectPreview from './ProjectPreview';
import ProjectVisual from './ProjectVisual.astro';
const projects=(await getCollection('projects')).sort((a,b)=>a.data.index-b.data.index);
const previewData=projects.map(p=>({id:p.id,...p.data}));
---
<section id="work" class="section-padding border-t border-hairline">
  <div class="container-editorial">
    <header class="mb-14 grid gap-6 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7"><p class="mono-label mb-4">Selected Work / 004</p><h2 class="heading-lg">Projects that turn systems into interfaces.</h2></div>
      <p class="max-w-md text-sm leading-6 text-graphite md:col-span-4 md:col-start-9">Maps, transport, resilient reporting, and spatial navigation—shown as systems rather than generic cards.</p>
    </header>
    <div class="relative md:grid md:grid-cols-12 md:gap-10">
      <div class="hidden md:col-span-5 md:block"><div class="sticky top-28"><ProjectPreview projects={previewData} client:visible /></div></div>
      <ol class="border-t border-hairline md:col-span-7">
        {projects.map((project,idx)=><li class="border-b border-hairline">
          <a href={`/work/${project.id}`} data-project-id={project.id} data-project-index={idx} data-cursor="view" class="group block py-6 md:py-8">
            <div class="flex items-start justify-between gap-4"><div class="flex items-baseline gap-4"><span class="font-mono text-xs text-graphite">0{idx+1}</span><h3 transition:name={`project-title-${project.id}`} class="font-display text-[clamp(1.8rem,3.4vw,3.8rem)] leading-none tracking-[-0.04em] transition-transform duration-300 group-hover:translate-x-1">{project.data.title}</h3></div><span class="text-accent opacity-0 transition-opacity group-hover:opacity-100">↗</span></div>
            <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 pl-10 font-mono text-[0.65rem] uppercase tracking-wider text-graphite"><span>{project.data.category}</span><span>{project.data.status}</span></div>
            <div class="mt-5 md:hidden"><ProjectVisual id={project.id} accent={project.data.accent} compact /></div>
          </a>
        </li>)}
      </ol>
    </div>
  </div>
</section>
