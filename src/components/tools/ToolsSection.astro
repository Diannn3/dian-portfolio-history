---

<section class="section-padding border-t border-hairline">
  <div class="container-editorial">
    <p class="mono-label mb-4">Tools I Reach For</p>
    <h2 class="text-h1 font-display text-ink mb-12">Stack</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {[
        { category: 'INTERFACE', items: 'Astro / React / TypeScript' },
        { category: 'COMPUTATION', items: 'Python / NumPy / Pandas' },
        { category: 'SPATIAL', items: 'MapLibre / PMTiles / GIS' },
        { category: 'VISUAL', items: 'Three.js / R3F / Spline / GSAP' },
        { category: 'AI', items: 'LLMs / ML tooling' },
        { category: 'SYSTEMS', items: 'Node / APIs / databases' },
      ].map((tool) => (
        <div class="border-l border-hairline pl-6">
          <p class="font-mono text-xs uppercase tracking-widest text-accent mb-2">{tool.category}</p>
          <p class="text-body">{tool.items}</p>
        </div>
      ))}
    </div>
  </div>
</section>