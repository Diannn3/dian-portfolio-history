---
import HeroCanvas from './HeroCanvas';
import HeroFallback from './HeroFallback.astro';
---
<section id="hero" class="relative min-h-[105svh] overflow-hidden bg-canvas" aria-labelledby="hero-title">
  <div class="absolute inset-0 z-0"><HeroFallback /></div>
  <div class="absolute inset-0 z-[1]" aria-hidden="true"><HeroCanvas client:only="react" /></div>
  <div class="container-editorial relative z-10 flex min-h-[100svh] items-center py-28 pointer-events-none">
    <div class="w-full max-w-4xl">
      <div class="mb-5 flex items-center gap-3">
        <span class="h-3 w-3 rounded-full border border-accent"></span>
        <p class="mono-label">Field / Applied Mathematics</p>
      </div>
      <h1 id="hero-title" class="display-xl font-display">DIAN</h1>
      <p class="mt-8 max-w-[13ch] font-display text-[clamp(2.1rem,4.6vw,4.8rem)] leading-[0.98] tracking-[-0.045em]">Builds systems between equations and interfaces.</p>
      <p class="body-lg mt-8 max-w-xl text-graphite">Applied Mathematics student building software, AI, maps, spatial systems, and experimental interfaces.</p>
      <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 font-mono text-[0.68rem] uppercase tracking-[0.15em] text-graphite">
        <span>Loc / Los Baños</span><span>System / Active</span><a href="#work" data-cursor="explore" class="pointer-events-auto border-b border-ink pb-1 text-ink">Explore work ↓</a>
      </div>
    </div>
  </div>
  <div class="pointer-events-none absolute bottom-6 right-[var(--gutter)] z-10 hidden font-mono text-[0.65rem] uppercase tracking-[0.16em] text-graphite lg:block">Scroll / collapse field</div>
</section>
