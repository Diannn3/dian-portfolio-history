---
const items=[['Vector Field Playground','EXPERIMENT'],['Gesture Interface','CONCEPT'],['Local LLM Experiments','PROTOTYPE'],['WebGL Map Experiments','EXPERIMENT'],['Computer Vision Interface','CONCEPT'],['Data Visualization Experiments','PROTOTYPE']];
---
<section id="lab" class="section-padding border-t border-hairline"><div class="container-editorial"><header class="mb-12 grid gap-5 md:grid-cols-12"><div class="md:col-span-7"><p class="mono-label mb-4">Lab / smaller work</p><h2 class="heading-lg">Experiments without pretending they are finished products.</h2></div></header><ol class="border-t border-hairline">{items.map(([title,status],i)=><li class="grid grid-cols-[3rem_1fr_auto] items-baseline gap-3 border-b border-hairline py-5"><span class="font-mono text-xs text-graphite">0{i+1}</span><span class="font-display text-xl md:text-2xl">{title}</span><span class="hidden font-mono text-[0.65rem] uppercase tracking-wider text-graphite sm:block">{status}</span></li>)}</ol></div></section>
