---

<section id="contact" class="section-padding border-t border-hairline">
  <div class="container-editorial">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <p class="mono-label mb-4">Contact</p>
        <h2 class="text-h1 font-display text-ink mb-8">
          Have a weird problem?<br />
          Let's build something useful.
        </h2>
        <div class="flex flex-col gap-4">
          <a href="mailto:hello@dian.dev" class="text-lg hover:text-accent transition-colors">hello@dian.dev</a>
          <a href="https://github.com/dian" target="_blank" rel="noopener noreferrer" class="text-lg hover:text-accent transition-colors">github.com/dian</a>
          <a href="https://linkedin.com/in/dian" target="_blank" rel="noopener noreferrer" class="text-lg hover:text-accent transition-colors">linkedin.com/in/dian</a>
        </div>
      </div>
      <div class="hidden lg:block">
        <!-- Decorative streamline SVG that reacts to pointer -->
        <svg id="contact-streamline" viewBox="0 0 600 300" class="w-full h-auto" aria-hidden="true">
          <path
            id="streamline-path"
            d="M50 150 C 150 50, 250 250, 350 150 C 450 50, 550 250, 600 150"
            stroke="#D8D4CC"
            stroke-width="1"
            fill="none"
            class="transition-all duration-500"
          />
        </svg>
      </div>
    </div>
  </div>
</section>

<script>
  // Subtle pointer interaction for streamline
  const path = document.getElementById('streamline-path');
  if (path && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.addEventListener('mousemove', (e) => {
      const rect = path.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      path.style.stroke = x > 0.5 ? '#D94F2B' : '#D8D4CC';
      path.style.strokeDasharray = `${x * 10 + 5} ${y * 5 + 5}`;
    });
  }
</script>