---
import MobileNav from './MobileNav.astro';
interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: '/#lab', label: 'Lab' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="fixed inset-x-0 top-0 z-50 text-ink mix-blend-difference" aria-label="Site header">
  <div class="container-editorial flex items-center justify-between py-5">
    <a href="/" class="font-display text-lg font-semibold tracking-[-0.04em] text-white" aria-label="Dian — home">DIAN</a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-white/65 transition-colors hover:text-white">{link.label}</a>
      ))}
      <span class="ml-3 flex items-center gap-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-white/65">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span> Building things
      </span>
    </nav>
    <MobileNav links={links} currentPath={currentPath} />
  </div>
</header>
