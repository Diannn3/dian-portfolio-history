---
interface Props {
  visual: "uppetite" | "pasada" | "disaster" | "campus"
  accent: string
}
const { visual, accent } = Astro.props
---

<div class="overflow-hidden border border-hairline bg-paper-2">
  {visual === "uppetite" && (
    <svg viewBox="0 0 1000 500" class="block h-auto w-full" role="img" aria-label="UPPETITE contribution and discovery system diagram">
      <rect width="1000" height="500" fill="#ebe7dc" />
      <g font-family="JetBrains Mono Variable, monospace" font-size="16" fill="#17150f">
        <text x="52" y="56" fill="#5a5750">SYSTEM / PLACE DATA LOOP</text>
        <g transform="translate(70 160)">
          <rect width="190" height="98" fill="#f2efe7" stroke="#bdb7aa" />
          <text x="20" y="38">COMMUNITY</text><text x="20" y="65" fill="#8a867c">CONTRIBUTION</text>
        </g>
        <g transform="translate(405 95)">
          <rect width="190" height="98" fill="#f2efe7" stroke={accent} stroke-width="2" />
          <text x="20" y="38">STRUCTURED</text><text x="20" y="65" fill={accent}>PLACE DATA</text>
        </g>
        <g transform="translate(740 160)">
          <rect width="190" height="98" fill="#f2efe7" stroke="#bdb7aa" />
          <text x="20" y="38">MAP</text><text x="20" y="65" fill="#8a867c">DISCOVERY</text>
        </g>
        <g transform="translate(405 330)">
          <rect width="190" height="98" fill="#f2efe7" stroke="#bdb7aa" />
          <text x="20" y="38">REVIEW</text><text x="20" y="65" fill="#8a867c">VERIFY / EDIT</text>
        </g>
      </g>
      <g fill="none" stroke="#8a867c" stroke-width="1.5" vector-effect="non-scaling-stroke">
        <path d="M260 209 C330 209 332 144 405 144" /><path d="M595 144 C670 144 666 209 740 209" />
        <path d="M835 258 C835 344 688 379 595 379" /><path d="M405 379 C298 379 160 326 165 258" />
      </g>
      <circle cx="405" cy="144" r="5" fill={accent}/><circle cx="595" cy="144" r="5" fill={accent}/>
    </svg>
  )}

  {visual === "pasada" && (
    <svg viewBox="0 0 1000 500" class="block h-auto w-full" role="img" aria-label="PASADA spatial information layers diagram">
      <rect width="1000" height="500" fill="#ebe7dc" />
      <text x="52" y="56" font-family="JetBrains Mono Variable, monospace" font-size="16" fill="#5a5750">SYSTEM / ONE ROUTE, MULTIPLE VIEWS</text>
      <path d="M65 268 C210 140 330 340 486 236 S748 112 935 252" fill="none" stroke="#17150f" stroke-width="3" />
      <path d="M65 268 C210 140 330 340 486 236 S748 112 935 252" fill="none" stroke={accent} stroke-width="15" opacity="0.12" />
      {[115,262,421,596,760,901].map((x, i) => (
        <g>
          <circle cx={x} cy={i % 2 ? 252 : 239} r="9" fill="#f2efe7" stroke="#17150f" stroke-width="2" />
          <rect x={x-24} y={355-(i%3)*25} width="48" height={46+(i%3)*25} fill={accent} opacity={0.08+i*0.03} />
        </g>
      ))}
      <g font-family="JetBrains Mono Variable, monospace" font-size="14" fill="#5a5750">
        <text x="72" y="455">PASSENGER / ETA + QUEUE</text>
        <text x="396" y="455">DRIVER / DEMAND FIELD</text>
        <text x="735" y="455">OPS / DISTRIBUTION</text>
      </g>
    </svg>
  )}

  {visual === "disaster" && (
    <svg viewBox="0 0 1000 500" class="block h-auto w-full" role="img" aria-label="Disaster response incident workflow diagram">
      <rect width="1000" height="500" fill="#ebe7dc" />
      <text x="52" y="56" font-family="JetBrains Mono Variable, monospace" font-size="16" fill="#5a5750">SYSTEM / REPORT → RESPONSE STATE</text>
      {[
        [70,"REPORT"],[248,"PARSE"],[426,"LOCATE"],[604,"CONTEXT"],[782,"PRIORITIZE"],
      ].map(([x,label], i) => (
        <g transform={`translate(${x} 170)`}>
          <rect width="145" height="90" fill="#f2efe7" stroke={i===4?accent:"#bdb7aa"} stroke-width={i===4?2:1} />
          <text x="18" y="38" font-family="JetBrains Mono Variable, monospace" font-size="14" fill="#17150f">{label}</text>
          <text x="18" y="63" font-family="JetBrains Mono Variable, monospace" font-size="11" fill={i===4?accent:"#8a867c"}>{String(i+1).padStart(2,"0")}</text>
        </g>
      ))}
      <g stroke="#8a867c" fill="none" stroke-width="1.5">
        <path d="M215 215 H248"/><path d="M393 215 H426"/><path d="M571 215 H604"/><path d="M749 215 H782"/>
        <path d="M854 260 C854 355 650 384 499 384 C325 384 142 349 142 260" stroke={accent} opacity="0.6"/>
      </g>
      <text x="386" y="412" font-family="JetBrains Mono Variable, monospace" font-size="13" fill={accent}>INCIDENT STATE / UPDATED AS EVIDENCE ARRIVES</text>
    </svg>
  )}

  {visual === "campus" && (
    <svg viewBox="0 0 1000 500" class="block h-auto w-full" role="img" aria-label="Campus to building to room navigation diagram">
      <rect width="1000" height="500" fill="#ebe7dc" />
      <text x="52" y="56" font-family="JetBrains Mono Variable, monospace" font-size="16" fill="#5a5750">SYSTEM / SCALE TRANSITION</text>
      <g fill="#f2efe7" stroke="#bdb7aa">
        <rect x="70" y="150" width="230" height="210"/><rect x="385" y="125" width="230" height="260"/><rect x="700" y="170" width="230" height="170"/>
      </g>
      <g font-family="JetBrains Mono Variable, monospace" fill="#17150f">
        <text x="95" y="190" font-size="15">CAMPUS</text><text x="410" y="165" font-size="15">BUILDING</text><text x="725" y="210" font-size="15">ROOM</text>
      </g>
      <g fill="none" stroke="#8a867c" stroke-width="1.5">
        <path d="M110 310 C160 215 229 307 269 220"/><path d="M420 332 H580 V180 H465 V264 H544"/><path d="M735 286 H889 V231 H802"/>
      </g>
      <path d="M269 220 C340 220 337 254 385 254 M615 254 C660 254 661 255 700 255" fill="none" stroke={accent} stroke-width="3"/>
      <circle cx="269" cy="220" r="5" fill={accent}/><circle cx="700" cy="255" r="5" fill={accent}/>
    </svg>
  )}
</div>
