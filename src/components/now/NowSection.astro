---
const items=[['Building','community + spatial tools'],['Learning','computational mathematics'],['Experimenting','AI agents + spatial interfaces'],['Exploring','creative WebGL']];
---
<section class="section-padding border-t border-hairline"><div class="container-editorial"><div class="mb-10 flex items-end justify-between"><div><p class="mono-label mb-4">Now / editable</p><h2 class="heading-lg">Current focus.</h2></div><span class="hidden font-mono text-xs text-graphite md:block">2026 / working set</span></div><div class="grid border-t border-hairline sm:grid-cols-2 lg:grid-cols-4">{items.map(([label,value])=><div class="border-b border-hairline py-6 sm:border-r sm:px-5 first:pl-0"><p class="font-mono text-[0.65rem] uppercase tracking-widest text-accent">{label}</p><p class="mt-3 max-w-[14rem] leading-6">{value}</p></div>)}</div></div></section>
