---
import HeroCanvas from "@/components/hero/HeroCanvas.tsx"
import HeroFallback from "@/components/hero/HeroFallback.tsx"
---

<section id="hero" class="relative h-[220vh]" aria-labelledby="hero-heading">
  <div class="sticky top-0 h-screen w-full overflow-hidden">
    <div class="absolute inset-0 opacity-65" aria-hidden="true">
      <HeroFallback />
    </div>

    <HeroCanvas client:only="react" />

    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(105% 92% at 53% 43%, transparent 30%, color-mix(in srgb, var(--color-paper) 52%, transparent) 72%, var(--color-paper) 112%);"
      aria-hidden="true"
    ></div>

    <div class="atlas-container pointer-events-none relative flex h-full flex-col justify-center pt-16">
      <div class="atlas-grid items-end">
        <div class="col-span-4 md:col-span-8 lg:col-span-9">
          <p class="label mb-6 flex items-center gap-3" data-reveal="rise">
            <span class="inline-block h-px w-10 bg-accent"></span>
            Applied Mathematics · software · spatial systems
          </p>

          <h1 id="hero-heading" class="display-xl max-w-[13.4ch] text-balance">
            <span class="block overflow-hidden"><span class="block" data-hero-line>DIAN BUILDS</span></span>
            <span class="block overflow-hidden"><span class="block" data-hero-line>SYSTEMS BETWEEN</span></span>
            <span class="block overflow-hidden"><span class="block" data-hero-line><span class="text-accent">EQUATIONS</span> AND</span></span>
            <span class="block overflow-hidden"><span class="block" data-hero-line>INTERFACES.</span></span>
          </h1>
        </div>

        <div class="col-span-4 mt-7 md:col-span-4 md:mt-10 lg:col-span-3 lg:mt-0">
          <p class="max-w-[39ch] text-body-lg text-graphite" data-reveal="rise">
            Applied Mathematics student building software, AI, maps, spatial systems, data tools, and experimental interfaces.
          </p>
        </div>
      </div>

      <div class="mono mt-10 flex flex-wrap items-center gap-x-5 gap-y-2 text-graphite-2" data-reveal="rise">
        <span>FIELD / APPLIED MATHEMATICS</span>
        <span aria-hidden="true">·</span>
        <span>LOC / LOS BAÑOS</span>
        <span aria-hidden="true">·</span>
        <span class="text-accent-ink">SYSTEM / ACTIVE</span>
      </div>
    </div>

    <div class="atlas-container pointer-events-none absolute inset-x-0 bottom-5">
      <div class="mono flex items-end justify-between gap-4 text-graphite-2">
        <span data-reveal="rise">SCROLL / 3D → DIAGRAM</span>
        <span class="hidden items-center gap-2 md:flex" data-reveal="rise">
          MOVE CURSOR TO SAMPLE FIELD
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        </span>
      </div>
    </div>
  </div>
</section>
