---
import { getCollection } from "astro:content"
import WorkIndex from "@/components/work/WorkIndex"

const entries = (await getCollection("projects", ({ data }) => data.featured)).sort(
  (a, b) => a.data.index - b.data.index,
)

const projects = entries.map((project) => ({
  id: project.id.replace(/\.mdx?$/, ""),
  title: project.data.title,
  shortTitle: project.data.shortTitle,
  index: project.data.index,
  status: project.data.status,
  year: project.data.year,
  category: project.data.category,
  summary: project.data.summary,
  accent: project.data.accent,
  visual: project.data.visual,
}))
---

<section id="work" class="relative border-t border-hairline py-24 md:py-36" aria-labelledby="work-heading">
  <div class="atlas-container">
    <header class="atlas-grid mb-14 items-end md:mb-20">
      <div class="col-span-4 md:col-span-8">
        <p class="label mb-4" data-reveal="rise">§01 · Selected work</p>
        <h2 id="work-heading" class="font-display max-w-[15ch] text-h2 text-balance" data-reveal="rise">
          Systems where maps, data, AI, and interfaces meet.
        </h2>
      </div>
      <div class="col-span-4 mt-6 md:col-span-4 md:mt-0">
        <p class="max-w-[42ch] text-graphite" data-reveal="rise">
          Four active project directions. Status is shown explicitly; no invented metrics, outcomes, or deployment claims.
        </p>
      </div>
    </header>

    <WorkIndex projects={projects} client:visible />
  </div>
</section>
