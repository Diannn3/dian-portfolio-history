---
const email = import.meta.env.PUBLIC_CONTACT_EMAIL
const github = import.meta.env.PUBLIC_GITHUB_URL
const linkedin = import.meta.env.PUBLIC_LINKEDIN_URL
const links = [
  { label: "EMAIL", value: email || "TO ADD", href: email ? `mailto:${email}` : undefined },
  { label: "GITHUB", value: github ? "OPEN PROFILE" : "TO ADD", href: github },
  { label: "LINKEDIN", value: linkedin ? "OPEN PROFILE" : "TO ADD", href: linkedin },
]
---

<section id="contact" class="relative overflow-hidden border-t border-hairline py-24 md:py-36" aria-labelledby="contact-heading">
  <svg class="pointer-events-none absolute inset-x-0 bottom-0 h-[65%] w-full opacity-55" viewBox="0 0 1200 420" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-40 332 C140 180 240 424 418 267 S696 66 850 214 S1067 372 1240 130" fill="none" stroke="#d9482b" stroke-width="2" vector-effect="non-scaling-stroke" />
    <path d="M-30 372 C174 239 280 446 447 310 S724 127 890 257 S1084 397 1240 202" fill="none" stroke="#b9b3a8" stroke-width="1" vector-effect="non-scaling-stroke" />
  </svg>

  <div class="atlas-container relative">
    <p class="label mb-6" data-reveal="rise">§07 · Contact</p>
    <h2 id="contact-heading" class="display-xl max-w-[10ch] text-balance" data-reveal="rise">
      Have a weird problem?
    </h2>
    <p class="font-display mt-4 max-w-[18ch] text-h2 text-graphite" data-reveal="rise">
      Let&apos;s build something useful.
    </p>

    <div class="atlas-grid mt-16 md:mt-24">
      <div class="col-span-4 md:col-span-8 md:col-start-5">
        <div class="border-t border-hairline bg-paper/85 backdrop-blur-[2px]">
          {links.map((link) => (
            link.href ? (
              <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer noopener" : undefined} class="group flex items-center justify-between border-b border-hairline py-4" data-cursor={link.href.startsWith("http") ? "external" : "default"}>
                <span class="label !text-ink">{link.label}</span>
                <span class="mono flex items-center gap-3 text-graphite group-hover:text-accent-ink">{link.value}<span aria-hidden="true">↗</span></span>
              </a>
            ) : (
              <div class="flex items-center justify-between border-b border-hairline py-4" aria-label={`${link.label} contact not supplied yet`}>
                <span class="label !text-ink">{link.label}</span>
                <span class="mono text-graphite-2">{link.value}</span>
              </div>
            )
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
