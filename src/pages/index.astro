---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/hero/Hero.astro';
import ProjectIndex from '@/components/work/ProjectIndex.astro';
import AboutSection from '@/components/about/AboutSection.astro';
import NowSection from '@/components/now/NowSection.astro';
import DigitalArtifact from '@/components/spline/DigitalArtifact';
import LabSection from '@/components/lab/LabSection.astro';
import ToolsSection from '@/components/tools/ToolsSection.astro';
import ContactSection from '@/components/contact/ContactSection.astro';
---
<BaseLayout>
  <Hero />
  <ProjectIndex />
  <AboutSection />
  <NowSection />
  <section class="section-padding border-t border-hairline">
    <div class="container-editorial grid gap-10 lg:grid-cols-12 lg:items-start"><div class="lg:col-span-4"><p class="mono-label mb-4">Object / 001 / Spline</p><h2 class="heading-lg">Computational artifact.</h2><p class="mt-5 max-w-sm leading-7 text-graphite">A separate authored 3D layer for exploring how mathematical structure might become an interactive object. The real Spline scene is intentionally supplied through an environment variable.</p></div><div class="lg:col-span-8"><DigitalArtifact client:only="react" /></div></div>
  </section>
  <LabSection />
  <ToolsSection />
  <ContactSection />
</BaseLayout>
