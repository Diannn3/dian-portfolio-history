---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Node Not Found · Aedrian Ponce"
  description="Requested resource does not exist in the current architecture."
>
  <div class="atmospheric-wrapper min-h-[80vh] flex items-center justify-center bg-[#050607] text-[#F5F5F7] px-6 py-24">
    <div class="atmospheric-grain" aria-hidden="true"></div>
    <div class="atmospheric-grid" aria-hidden="true"></div>
    <div class="atmospheric-glow" aria-hidden="true"></div>

    <div class="relative z-10 max-w-lg w-full p-8 sm:p-10 bg-[#101214] border border-[#22262B] rounded-xl text-center space-y-6 shadow-2xl">
      <div class="w-16 h-16 mx-auto">
        <img
          src="/brand/aedrian-a.svg"
          alt="Aedrian A Mark"
          class="w-full h-full object-contain opacity-80"
        />
      </div>

      <div class="space-y-2">
        <div class="font-mono text-xs text-[#8EBBC8] uppercase tracking-widest">
          ERROR_CODE: 404 // NODE_NULL
        </div>
        <h1 class="text-3xl sm:text-4xl font-display font-bold text-[#F5F5F7]">
          Coordinate Not Found
        </h1>
        <p class="font-body text-sm text-[#8C9296] leading-relaxed">
          The requested coordinate does not exist in this system topology or has been relocated to an alternative node.
        </p>
      </div>

      <div class="p-4 bg-[#050607] border border-[#22262B] rounded-lg font-mono text-[11px] text-[#666B6E] text-left space-y-1">
        <div>$ sys.resolve_path(request.uri)</div>
        <div class="text-rose-400">→ STATUS: 404 (Unmapped graph edge)</div>
      </div>

      <div class="pt-2 flex flex-wrap gap-2.5 justify-center font-mono text-xs">
        <a
          href="/"
          class="px-4 py-2.5 bg-[#8EBBC8] text-[#050607] font-bold hover:bg-[#A5D0DC] transition-colors rounded shadow-md"
        >
          // Return to Index
        </a>
        <a
          href="/work/"
          class="px-4 py-2.5 border border-[#22262B] bg-[#181B1E] text-[#C8CDD0] hover:text-[#FFFFFF] hover:border-[#8EBBC8] transition-colors rounded"
        >
          // Browse Work
        </a>
        <a
          href="/about/"
          class="px-4 py-2.5 border border-[#22262B] bg-[#181B1E] text-[#C8CDD0] hover:text-[#FFFFFF] hover:border-[#8EBBC8] transition-colors rounded"
        >
          // About
        </a>
      </div>
    </div>
  </div>
</Layout>
