---
import BaseLayout from './BaseLayout.astro';
import ProjectVisual from '@/components/work/ProjectVisual.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props; const { data }=project;
---
<BaseLayout title={`${data.title} — Dian`} description={data.summary}>
  <article class="pb-24 pt-32">
    <header class="container-editorial">
      <a href="/#work" class="mono-label inline-block border-b border-hairline pb-1">← Selected work</a>
      <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8"><p class="mono-label mb-4">0{data.index} / {data.category} / {data.status}</p><h1 transition:name={`project-title-${project.id}`} class="display-lg">{data.title}</h1><p class="body-lg mt-6 max-w-2xl text-graphite">{data.thesis}</p></div>
        <dl class="grid gap-5 text-sm lg:col-span-3 lg:col-start-10"><div><dt class="mono-label">Role</dt><dd class="mt-1">{data.role ?? 'To verify'}</dd></div><div><dt class="mono-label">Stack</dt><dd class="mt-1 leading-6">{data.technologies.join(' / ')}</dd></div><div><dt class="mono-label">Year</dt><dd class="mt-1">{data.year ?? 'To verify'}</dd></div></dl>
      </div>
      <div class="mt-14"><ProjectVisual id={project.id} accent={data.accent}/></div>
    </header>
    <div class="container-editorial mt-16 grid gap-12 lg:grid-cols-12"><div class="lg:col-span-3"><p class="mono-label sticky top-28">Case study / current state</p></div><div class="prose-portfolio lg:col-span-8"><slot /></div></div>
  </article>
</BaseLayout>
