---
import "@/styles/global.css"
import SEO from "@/components/global/SEO.astro"
import Header from "@/components/global/Header.astro"
import Footer from "@/components/global/Footer.astro"
import Cursor from "@/components/global/Cursor.tsx"
import { ClientRouter } from "astro:transitions"

interface Props {
  title: string
  description: string
  image?: string
}
const { title, description, image } = Astro.props
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SEO title={title} description={description} image={image} />
    <ClientRouter />
    <script is:inline>
      // swap no-js -> js as early as possible so reveal styles apply
      document.documentElement.classList.remove("no-js")
      document.documentElement.classList.add("js")
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <Cursor client:idle />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { initSmoothScroll } from "@/lib/motion/smooth-scroll"
      import { initReveals } from "@/lib/motion/reveals"
      import { ScrollTrigger } from "gsap/ScrollTrigger"
      
      let teardownScroll: (() => void) | null = null
      let revealCtx: ReturnType<typeof initReveals> | null = null

      function boot() {
        teardownScroll = initSmoothScroll()
        revealCtx = initReveals()
        requestAnimationFrame(() => ScrollTrigger.refresh())
      }

      function teardown() {
        revealCtx?.revert()
        revealCtx = null
        teardownScroll?.()
        teardownScroll = null
      }

      // handle Astro view-transition lifecycle cleanly
      document.addEventListener("astro:page-load", boot)
      document.addEventListener("astro:before-swap", teardown)
    </script>
  </body>
</html>
