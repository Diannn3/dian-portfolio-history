---
import { getCollection } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
const projects=(await getCollection('projects',({data})=>data.featured)).sort((a,b)=>a.data.index.localeCompare(b.data.index));
---
<section id="work" class="section shell" data-work>
  <header class="work-head">
    <div><span class="eyebrow">SELECTED / 004</span><div data-reveal="clip"><h2 class="section-title" style="margin:.6rem 0 0">Selected work.</h2></div></div>
    <span class="eyebrow">SYSTEMS WITH A PHYSICAL CONTEXT</span>
  </header>
  <div class="work-grid">
    {projects.map((project) => <article class="project-row" data-project-row={project.id} data-accent={project.data.accent}>
      <span class="eyebrow">{project.data.index}</span>
      <div><a href={`/work/${project.id}`} data-cursor="view" transition:name={`title-${project.id}`}><h3>{project.data.title}</h3></a><div class="project-meta" style="margin-top:.7rem">{project.data.summary}</div></div>
      <div class="project-meta project-side"><strong style="color:var(--ink);font-weight:500">{project.data.category}</strong><br/>{project.data.status}</div>
      <span class="eyebrow">{project.data.year}</span><span class="project-arrow">↗</span>
    </article>)}
  </div>
  <div class="work-preview" data-work-preview aria-hidden="true">
    {projects.map((project)=><div class="preview-panel" data-preview-panel={project.id}><ProjectVisual type={project.data.visual} accent={project.data.accent}/></div>)}
  </div>
</section>
<script>
  function initWorkPreview(){ if(!matchMedia('(pointer:fine)').matches)return; const wrap=document.querySelector('[data-work-preview]'); const rows=[...document.querySelectorAll('[data-project-row]')]; if(!(wrap instanceof HTMLElement)||!rows.length)return; let tx=innerWidth*.7,ty=innerHeight*.5,x=tx,y=ty,raf=0; const loop=()=>{x+=(tx-x)*.12;y+=(ty-y)*.12;wrap.style.transform=`translate(${x}px,${y}px) translate(-50%,-50%) scale(1)`;raf=requestAnimationFrame(loop)}; const move=(e)=>{tx=e.clientX+150;ty=e.clientY+20}; rows.forEach(row=>{row.addEventListener('mouseenter',()=>{wrap.dataset.active='true';const id=row.getAttribute('data-project-row');wrap.querySelectorAll('[data-preview-panel]').forEach(p=>p.toggleAttribute('data-active',p.getAttribute('data-preview-panel')===id));});row.addEventListener('mouseleave',()=>wrap.dataset.active='false');row.addEventListener('mousemove',move)});loop();document.addEventListener('astro:before-swap',()=>cancelAnimationFrame(raf),{once:true}); }
  document.addEventListener('astro:page-load',initWorkPreview);
</script>
