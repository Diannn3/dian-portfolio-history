---
import { nowItems } from '../data/site';
---
<section class="section shell">
  <div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:3rem"><div><span class="eyebrow">NOW / 2026</span><div data-reveal="clip"><h2 class="section-title" style="margin:.6rem 0 0">Currently in motion.</h2></div></div><span class="eyebrow">LIVE CONTEXT / SUBJECT TO CHANGE</span></div>
  <div class="now-grid">{nowItems.map(item=><div class="now-item" data-reveal="meta"><span class="eyebrow">{item.label}</span><div class="now-value">{item.value}</div></div>)}</div>
</section>
