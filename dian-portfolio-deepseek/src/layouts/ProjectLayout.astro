---
import BaseLayout from './BaseLayout.astro';
import ProjectVisual from '../components/work/ProjectVisual.astro';
const { project, nextProject } = Astro.props;
---
<BaseLayout title={`${project.data.title} — Dian`} description={project.data.summary}>
  <article>
    <header class="project-hero shell">
      <a href="/#work" class="eyebrow" data-cursor="back">← BACK TO WORK</a>
      <div class="project-hero-grid">
        <div><div style="display:flex;gap:1rem;margin-top:2rem"><span class="eyebrow">{project.data.index} / {project.data.year}</span><span class="eyebrow" style={`color:${project.data.accent}`}>{project.data.status}</span></div><h1 class="project-title" transition:name={`title-${project.id}`}>{project.data.title}</h1></div>
        <p class="project-thesis">{project.data.thesis}</p>
      </div>
      <div class="project-media" transition:name={`visual-${project.id}`}><ProjectVisual type={project.data.visual} accent={project.data.accent}/></div>
      <div class="project-details"><div class="project-detail"><span class="eyebrow">ROLE</span><p>{project.data.role.join(' / ')}</p></div><div class="project-detail"><span class="eyebrow">TECH</span><p>{project.data.technologies.join(' / ')}</p></div><div class="project-detail"><span class="eyebrow">CATEGORY</span><p>{project.data.category}</p></div><div class="project-detail"><span class="eyebrow">STATUS</span><p>{project.data.status}</p></div></div>
    </header>
    <div class="project-body shell"><aside><span class="eyebrow">CASE STUDY / VERIFIED CONTENT</span><p class="muted" style="line-height:1.6">This page intentionally separates verified project context from future outcomes or metrics.</p></aside><article><slot /></article></div>
    <footer class="next-project shell"><span class="eyebrow">NEXT PROJECT</span><a href={`/work/${nextProject.id}`} data-cursor="view"><strong>{nextProject.data.title} ↗</strong></a></footer>
  </article>
</BaseLayout>
